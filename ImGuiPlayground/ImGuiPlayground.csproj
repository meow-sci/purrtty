<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- Explicit build/publish RID takes precedence over the portable SDK host RID.
             Distro SDKs may report e.g. fedora.44-x64 as NETCoreSdkRuntimeIdentifier. -->
        <PlaygroundNativeRid>$(RuntimeIdentifier)</PlaygroundNativeRid>
        <PlaygroundNativeRid Condition="'$(PlaygroundNativeRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</PlaygroundNativeRid>
    </PropertyGroup>
    <Import Project="runtimes/NativeLibraries.props" />

    <!-- Real KSA managed bindings remain external, resolved by our local build config. -->
    <ItemGroup>
        <InternalsVisibleTo Include="ImGuiPlayground.Checks" />
        <None Update="licenses/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <None Update="fonts/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <None Update="LICENSE;THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <!-- Stage only the selected native pair, with the filenames BRUTAL expects.
             ExcludeAssets avoids NuGet also copying its default/all-RID native layout. -->
        <PackageReference Include="Ultz.Native.GLFW" Version="3.4.0" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
        <None Remove="runtimes/**" />
        <None Include="runtimes/README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <!-- Always refresh: a newly pinned package can have OLDER timestamps than a
             previously staged runtime. PreserveNewest would silently keep the wrong DLL. -->
        <None Include="@(_PlaygroundNative)" Link="%(_PlaygroundNative.TargetPath)" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
        <!-- Dependencies of the current BRUTAL GLFW/logging/string assemblies. -->
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="11.0.0-rc.1.26425.128" />
        <Reference Include="Brutal.ImGui"><HintPath>$(_PlaygroundKsaFolder)Brutal.ImGui.dll</HintPath><Private>true</Private></Reference>
        <Reference Include="Brutal.Glfw"><HintPath>$(_PlaygroundKsaFolder)Brutal.Glfw.dll</HintPath><Private>true</Private></Reference>
        <Reference Include="Brutal.Core.Common"><HintPath>$(_PlaygroundKsaFolder)Brutal.Core.Common.dll</HintPath><Private>true</Private></Reference>
        <Reference Include="Brutal.Core.Strings"><HintPath>$(_PlaygroundKsaFolder)Brutal.Core.Strings.dll</HintPath><Private>true</Private></Reference>
        <Reference Include="Brutal.Core.Numerics"><HintPath>$(_PlaygroundKsaFolder)Brutal.Core.Numerics.dll</HintPath><Private>true</Private></Reference>
    </ItemGroup>
    <Target Name="ValidatePlaygroundNative" BeforeTargets="PrepareForBuild;ResolveAssemblyReferences;GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems" Condition="'$(DesignTimeBuild)' != 'true'">
        <Error Condition="'$(PlaygroundNativeRid)' != 'osx-arm64' AND '$(PlaygroundNativeRid)' != 'linux-x64' AND '$(PlaygroundNativeRid)' != 'win-x64'"
               Text="Unsupported playground runtime '$(PlaygroundNativeRid)'. Supported RIDs: osx-arm64, linux-x64, win-x64. Use -r to select a supported target." />
        <Error Condition="!Exists('%(_PlaygroundNative.Identity)')"
               Text="Pinned playground native asset is missing: '%(_PlaygroundNative.Identity)'. Restore NuGet packages and ensure the vendored runtimes are present. See ImGuiPlayground/runtimes/README.md." />
        <VerifyFileHash File="%(_PlaygroundNative.Identity)" Hash="%(_PlaygroundNative.Sha256)" Algorithm="SHA256" />
    </Target>
</Project>
