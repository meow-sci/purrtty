<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- The package owns the host and all native/font delivery. BRUTAL stays external. -->
    <ItemGroup>
        <PackageReference Include="XBrutal.ImGuiStandalone" Version="[0.1.0-local.4]" />
        <InternalsVisibleTo Include="ImGuiPlayground.Checks" />
        <None Update="licenses/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <None Update="LICENSE;THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Reference Include="Brutal.ImGui"><HintPath>$(_PlaygroundKsaFolder)Brutal.ImGui.dll</HintPath><Private>true</Private></Reference>
        <Reference Include="Brutal.Glfw"><HintPath>$(_PlaygroundKsaFolder)Brutal.Glfw.dll</HintPath><Private>true</Private></Reference>
        <Reference Include="Brutal.Core.Common"><HintPath>$(_PlaygroundKsaFolder)Brutal.Core.Common.dll</HintPath><Private>true</Private></Reference>
        <Reference Include="Brutal.Core.Strings"><HintPath>$(_PlaygroundKsaFolder)Brutal.Core.Strings.dll</HintPath><Private>true</Private></Reference>
        <Reference Include="Brutal.Core.Numerics"><HintPath>$(_PlaygroundKsaFolder)Brutal.Core.Numerics.dll</HintPath><Private>true</Private></Reference>
    </ItemGroup>
</Project>
