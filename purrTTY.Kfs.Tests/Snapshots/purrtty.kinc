.equ X_PARTS_DIRTY, 1
.equ X_PARTS_LIGHTS, 2
.equ X_PARTS_DEPLOYABLES, 3
.equ X_PARTS_ACTUATORS, 4

; x_part_kind: part kinds of x_parts_describe
.equ X_KIND_ALL, 0
.equ X_KIND_LIGHT, 1
.equ X_KIND_DEPLOYABLE, 2
.equ X_KIND_ACTUATOR, 3

; x_light_prop: light properties: integers 0..15 (x_light_geti), floats 16 and up (x_light_getf)
