.equ X_DEPLOY_DURATION_S, 18

; x_actuator_prop: actuator properties: integers 0..15 (x_actuator_geti), floats 16 and up (x_actuator_getf); position and target are 0..1 of the travel
.equ X_ACTUATOR_PRESENT, 0
.equ X_ACTUATOR_MOVING, 1
.equ X_ACTUATOR_PART_ID, 2
.equ X_ACTUATOR_LINKS, 3
.equ X_ACTUATOR_POSITION, 16
