+        if (gop.found_existing) {
+            // Replacing an external (image id, placement id) pair: untrack the
+            // old placement's pin first (purrtty patch). Without this, every
+            // same-id re-display — the kitty video pattern, one a=T per frame —
+            // leaked a tracked pin, growing PageList.tracked_pins without bound
+            // and eventually failing trackPin (silently under q=2: the stream
+            // goes permanently blank while text keeps working).
+            gop.value_ptr.deinit(s);
+        }
         gop.value_ptr.* = p;
 
         self.dirty = true;
