<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>kfs-service-catalog-sim</AssemblyName>
    <RootNamespace>PurrKfs</RootNamespace>
    <!-- Throw-away spike: no XML docs. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reference the UNMODIFIED snapshot DLLs; nothing is copied to the output.
         Program.Main resolves them at run time from KSA_DLL_DIR (and patches KSA.dll's
         PE machine field in memory on arm64). -->
    <Reference Include="$(KSA_DLL_DIR)/*.dll">
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>
</Project>
