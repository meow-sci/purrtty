<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <AssemblyName>purrTTY.Logging</AssemblyName>
        <RootNamespace>purrTTY.Logging</RootNamespace>
        <Description>Logging abstractions and adapters for purrTTY</Description>
        <PackageId>purrTTY.Logging</PackageId>
        <Product>purrTTY Terminal Emulator</Product>
        <Company>purrTTY Project</Company>
        <Copyright>Copyright © purrTTY Project</Copyright>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <RequiresKSAAssemblies>true</RequiresKSAAssemblies>

    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
        <Reference Include="Brutal.Logging" Condition="Exists('$(KSAFolder)/Brutal.Logging.dll')">
            <HintPath>$(KSAFolder)/Brutal.Logging.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

</Project>
