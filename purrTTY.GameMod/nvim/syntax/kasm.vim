" Vim syntax file
" Language:   kASM, the kFS assembler of Kitten Space Agency (*.kasm, *.kinc)
" Shipped by: purrTTY (nvim/syntax/kasm.vim in the mod folder)
"
" GENERATED by purrTTY.Kfs.Tools.Tests (KasmSyntaxTests) from the game itself: the
" mnemonics of its opcode table (GameTables.OpcodesByMnemonic) and the directive names
" its assembler (KSA.Kfs.KAsm.Assembler) recognises. Do not edit by hand; after a game
" update run the tests with PURRTTY_UPDATE_SNAPSHOTS=1 and commit the result.

if exists('b:current_syntax')
  finish
endif

let s:cpo_save = &cpo
set cpo&vim

" Mnemonics and directives are case-insensitive (the assembler compares them upper- and
" lower-cased); everything else is case-sensitive.
syn case ignore

" A mnemonic is the first word of a statement (Assembler.Split: an optional label 'name:'
" followed by white space, then the word), ending at white space, ';' or the end of the
" line: a label, an operand or a directive's argument spelled like one (copy:, index,
" .func enter) is not one.
syn match kasmMnemonic /\%(^\s*\%(\h\w*\s*:\s\+\)\=\)\@<=\%(ADD\|ADD64\|ADDRL\|AND\|AND64\|BOUNDS\|BRK\|CALL\|CALLF\|COPY\|D2F\|D2I\)\%(\s\|;\|$\)\@=/
syn match kasmMnemonic /\%(^\s*\%(\h\w*\s*:\s\+\)\=\)\@<=\%(D2L\|D2LU\|D2U\|DABS\|DADD\|DDIV\|DEQ\|DGE\|DGT\|DIV\|DIV64\|DIVU\)\%(\s\|;\|$\)\@=/
syn match kasmMnemonic /\%(^\s*\%(\h\w*\s*:\s\+\)\=\)\@<=\%(DIVU64\|DLE\|DLT\|DMUL\|DNE\|DNEG\|DROP\|DROP2\|DSQRT\|DSUB\|DUP\|DUP2\)\%(\s\|;\|$\)\@=/
syn match kasmMnemonic /\%(^\s*\%(\h\w*\s*:\s\+\)\=\)\@<=\%(ENTER\|EQ\|EQ64\|F2D\|F2I\|F2L\|F2U\|FABS\|FADD\|FDIV\|FEQ\|FGE\)\%(\s\|;\|$\)\@=/
syn match kasmMnemonic /\%(^\s*\%(\h\w*\s*:\s\+\)\=\)\@<=\%(FGT\|FLE\|FLT\|FMUL\|FNE\|FNEG\|FSQRT\|FSUB\|GE\|GE64\|GEU\|GEU64\)\%(\s\|;\|$\)\@=/
syn match kasmMnemonic /\%(^\s*\%(\h\w*\s*:\s\+\)\=\)\@<=\%(GT\|GT64\|GTU\|GTU64\|I2D\|I2F\|I2L\|INDEX\|JMP\|JNZ\|JZ\|L2D\)\%(\s\|;\|$\)\@=/
syn match kasmMnemonic /\%(^\s*\%(\h\w*\s*:\s\+\)\=\)\@<=\%(L2F\|L2I\|LD64\|LDB\|LDBU\|LDG\|LDG64\|LDH\|LDHU\|LDL\|LDL64\|LDW\)\%(\s\|;\|$\)\@=/
syn match kasmMnemonic /\%(^\s*\%(\h\w*\s*:\s\+\)\=\)\@<=\%(LE\|LE64\|LEU\|LEU64\|LT\|LT64\|LTU\|LTU64\|LU2D\|MUL\|MUL64\|NE\)\%(\s\|;\|$\)\@=/
syn match kasmMnemonic /\%(^\s*\%(\h\w*\s*:\s\+\)\=\)\@<=\%(NE64\|NEG\|NEG64\|NOP\|NOT\|NOT64\|OR\|OR64\|OVER\|OVER2\|PUSH16\|PUSH32\)\%(\s\|;\|$\)\@=/
syn match kasmMnemonic /\%(^\s*\%(\h\w*\s*:\s\+\)\=\)\@<=\%(PUSH64\|PUSH8\|REM\|REM64\|REMU\|REMU64\|RET\|SAR\|SAR64\|SEXT16\|SEXT8\|SHL\)\%(\s\|;\|$\)\@=/
syn match kasmMnemonic /\%(^\s*\%(\h\w*\s*:\s\+\)\=\)\@<=\%(SHL64\|SHR\|SHR64\|ST64\|STB\|STG\|STG64\|STH\|STL\|STL64\|STW\|SUB\)\%(\s\|;\|$\)\@=/
syn match kasmMnemonic /\%(^\s*\%(\h\w*\s*:\s\+\)\=\)\@<=\%(SUB64\|SWAP\|SWAP2\|SYSCALL\|TRAP\|U2D\|U2F\|U2L\|XOR\|XOR64\|YIELD\|ZERO\)\%(\s\|;\|$\)\@=/
syn match kasmMnemonic /\%(^\s*\%(\h\w*\s*:\s\+\)\=\)\@<=\%(ZEXT16\|ZEXT8\)\%(\s\|;\|$\)\@=/

" A directive is a word starting with '.', first on the line or after a label.
syn match kasmDirective /\%(^\|\s\)\zs\.\%(args\|args64\|bounds\|byte\|claim\|const\|data\|double\|endconst\|enddata\|endfunc\|endm\|endscope\|equ\|extern\|float\|format\|func\|global\|half\|include\|init\|loc\|local\|local64\|long\|loop_bound\|macro\|program\|proto\|publish\|scope\|strict\|string\|subscribe\|task\|tick_hz\|word\|zero\)\>/
" IR-only directives: the assembler rejects them (KA-E002).
syn match kasmError /\%(^\|\s\)\zs\.\%(endloop\|lang\|loop\)\>/

syn case match

syn keyword kasmBuiltin sizeof alignof offsetof
syn match kasmConstant /\<\%(SVC\|TRAP\|MSG\|KFS\|X\)_\w\+\>/
syn match kasmMacroParam /\\\h\w*/
syn match kasmLabel /^\s*\h\w*\ze\s*:\%(\S\)\@!/
syn match kasmNumber /\<\d[0-9_]*\>/
syn match kasmNumber /\<0[xX][0-9A-Fa-f_]\+\>/
syn match kasmNumber /\<0[bB][01_]\+\>/
syn match kasmFloat /\<\d[0-9_]*\.\d[0-9_]*\%([eE][+-]\=\d\+\)\=[fFdD]\=\>/
syn match kasmFloat /\<\d[0-9_]*[eE][+-]\=\d\+[fFdD]\=\>/
syn match kasmInclude /<\%(kfs\.kinc\|vehicle\.kinc\)>/
syn region kasmString start=/"/ skip=/\\[\\"]/ end=/"/ oneline contains=kasmEscape
syn match kasmEscape contained /\\./
syn keyword kasmTodo contained TODO FIXME XXX NOTE
" ';' starts a comment except inside a string (the string starts first and wins). kASM has no
" character literals: the assembler (StripComment) cuts a line at a ';' in quotes '...' too.
syn match kasmComment /;.*$/ contains=kasmTodo,@Spell

hi def link kasmMnemonic   Statement
hi def link kasmDirective  PreProc
hi def link kasmError      Error
hi def link kasmBuiltin    Keyword
hi def link kasmConstant   Constant
hi def link kasmMacroParam Identifier
hi def link kasmLabel      Label
hi def link kasmNumber     Number
hi def link kasmFloat      Float
hi def link kasmInclude    Include
hi def link kasmString     String
hi def link kasmEscape     SpecialChar
hi def link kasmTodo       Todo
hi def link kasmComment    Comment

let b:current_syntax = 'kasm'

let &cpo = s:cpo_save
unlet s:cpo_save
