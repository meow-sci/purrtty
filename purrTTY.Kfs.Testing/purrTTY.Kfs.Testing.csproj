<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <AssemblyName>purrTTY.Kfs.Testing</AssemblyName>
        <RootNamespace>purrTTY.Kfs.Testing</RootNamespace>
        <Description>Runs the game's kFS and purrTTY's extension outside the game (test runtime; not shipped with the mod)</Description>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <RequiresKSAAssemblies>true</RequiresKSAAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\purrTTY.Kfs\purrTTY.Kfs.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- KfsRuntime applies the extension's host hooks with its own Harmony instance. The
             consumer supplies 0Harmony.dll at run time (the test project references it normally). -->
        <PackageReference Include="Lib.Harmony" Version="2.4.2">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- KSA game DLLs: compile-only, never copied to an output. KsaAssemblyResolver
             supplies them at run time from the developer's own copy. -->
        <Reference Include="KSA" Condition="Exists('$(KSAFolder)/KSA.dll')">
            <HintPath>$(KSAFolder)/KSA.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

</Project>
